{
  "name": "qa-cypress",
  "version": "1.0.0",
  "description": "Test project for learning cypress basics",
  "main": "index.js",
  "scripts": {
    "test": "npx cypress test",
    "test:cloud": "npx cypress run --record --key f0c4752c-3050-491f-bc5b-da3744ee9e88",
    "open": "npx cypress open --config-file cypress.config.js",
    "open:second": "npx cypress open --config-file cypress.config.2.js",
    "run:basic": "npx cypress run --config-file cypress.config.js",
    "run:second": "npx cypress run --config-file cypress.config.2.js",
    "merge-reports": "npx mochawesome-merge \"cypress/results/*.json\" > mochawesome.json",
    "generate-report": "npx marge mochawesome.json",
    "report": "npm run merge-reports && npm run generate-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Helga-vm/qa-cypress.git"
  },
  "keywords": [
    "learning"
  ],
  "author": "Olha K.",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Helga-vm/qa-cypress/issues"
  },
  "homepage": "https://github.com/Helga-vm/qa-cypress#readme",
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "cypress": "^15.5.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.3.2"
  }
}
